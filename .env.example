# Copy this file to `.env` (same folder as docker-compose.yml) and fill in real values.
# docker compose auto-loads .env. Both values are REQUIRED — compose fails fast without them.

# JWT signing key, min 32 chars. Generate: openssl rand -base64 48
JWT_SIGNING_KEY=

# SQL Server SA password. Min 8 chars incl. upper/lower/digit/symbol.
# NEVER commit the real .env to source control.
MSSQL_SA_PASSWORD=

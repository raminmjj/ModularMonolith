{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Identity": "",
    "Catalog": "",
    "Orders": ""
  },
  "Jwt": {
    "Issuer": "ModularMonolith",
    "Audience": "ModularMonolith.Clients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Host": {
    "AllowedCorsOrigins": []
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ModularMonolith.Modules.Payment.Application</RootNamespace>
    <Description>Payment hexagon: Domain + Ports + Service. Knows Customer ONLY through ICustomerGatewayPort + Contracts DTOs.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\DDD\ModularMonolith.DDD.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\SharedKernel\ModularMonolith.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Contracts\ModularMonolith.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Framework\ModularMonolith.Framework.csproj" />
    <!--
      Payment.Application does NOT reference Customer.Application — this preserves
      the module boundary. ICustomerGatewayPort uses only Contracts types
      (CustomerStatusDto, SavedPaymentMethodDto). The direct call to Customer's
      ICustomerInboundPort happens in Payment.Adapter.Outbound/Gateways/CustomerGateway.
    -->
  </ItemGroup>
</Project>
